# ============================================================================
# TeleFleet & AutoClip AI - Ortam Değişkenleri (.env)
# ============================================================================

# --- PostgreSQL Veritabanı ---
POSTGRES_USER=fleetadmin
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=telefleet
DATABASE_URL=postgres://fleetadmin:supersecretpassword@postgres:5432/telefleet?sslmode=disable

# --- Redis Kuyruk & Önbellek ---
REDIS_URL=redis:6379

# --- Telegram Bot & Local Bot API (2 GB Dosya Desteği) ---
TELEGRAM_BOT_TOKEN=1234567890:AAH_your_bot_token_here
TELEGRAM_BOT_USERNAME=TurDiziMasterBot
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
LOCAL_BOT_API_URL=http://telegram-bot-api:8081

# --- Lokal AI Yapılandırması (Ollama + Faster-Whisper + FFmpeg) ---
OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=qwen2.5:14b
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
FFMPEG_USE_NVENC=true
MEDIA_ROOT=/var/lib/telegram-bot-api/media
POLL_INTERVAL_SECONDS=300

# --- Web Sunucusu ve Ödeme (Telegram Stars XTR) ---
WEB_SERVER_PORT=8080
WEB_PLAYER_URL=http://localhost:8080/watch
VIP_PRICE_STARS=50
VIP_DURATION_DAYS=30
REQUIRED_CHANNELS=@TurDizi_AnaHub,@Zimorodok_Official_RU

